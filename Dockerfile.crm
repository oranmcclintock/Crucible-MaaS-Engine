FROM python:3.11-slim

WORKDIR /app

# Create a non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Install dependencies
RUN pip install --no-cache-dir requests python-dateutil pandas streamlit

# Copy the CRM directory
COPY crm/ /app/crm/

# Set working directory to the CRM folder so SQLite db is in context
WORKDIR /app/crm

# Set ownership and switch to non-root user
RUN chown -R appuser:appuser /app
USER appuser

# Expose Streamlit port
EXPOSE 8501

# Run the Streamlit Dashboard
CMD ["streamlit", "run", "crm_ui.py", "--server.port=8501", "--server.address=0.0.0.0"]
