<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ branding.brand_name }} — Schema Audit ({{ metadata.source_redacted_url }})</title>
  <style>
    :root {
      --brand-color: {{ branding.brand_color }};
      --bg: #ffffff;
      --surface: #f8fafc;
      --ink: #0f172a;
      --muted: #475569;
      --border: #e2e8f0;
      --red: #b91c1c;
      --red-bg: #fef2f2;
      --amber: #b45309;
      --amber-bg: #fffbeb;
      --green: #15803d;
      --green-bg: #f0fdf4;
      --blue: #1d4ed8;
      --blue-bg: #eff6ff;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      --sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { -webkit-text-size-adjust: 100%; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.55;
      border-top: 3px solid var(--brand-color);
    }

    code, pre {
      font-family: var(--mono);
      font-size: 12.5px;
    }

    code {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 1px 4px;
      word-break: break-word;
    }

    .wrap {
      max-width: 1040px;
      margin: 0 auto;
      padding: 24px 20px 48px;
    }

    header {
      padding-bottom: 16px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .header-top {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .brand-logo {
      max-height: 32px;
      max-width: 140px;
      object-fit: contain;
    }

    h1 {
      margin: 0;
      font-size: 20px;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    .meta-line {
      margin: 8px 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      font-size: 12.5px;
      color: var(--muted);
    }

    .meta-line span { word-break: break-all; }

    h2 {
      margin: 32px 0 10px;
      padding-bottom: 6px;
      font-size: 15px;
      font-weight: 650;
      border-bottom: 1px solid var(--border);
    }

    h3 {
      margin: 18px 0 8px;
      font-size: 13.5px;
      font-weight: 650;
      color: var(--ink);
    }

    p { margin: 0 0 12px; color: var(--muted); }
    p strong { color: var(--ink); }

    .summary-bar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      margin: 16px 0 24px;
    }

    .metric {
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 12px 14px;
      background: var(--surface);
    }

    .metric.score-RED { border-left: 3px solid var(--red); }
    .metric.score-AMBER { border-left: 3px solid var(--amber); }
    .metric.score-GREEN { border-left: 3px solid var(--green); }

    .metric-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .metric-val {
      font-family: var(--mono);
      font-size: 20px;
      font-weight: 700;
      color: var(--ink);
      line-height: 1.2;
    }

    .metric-sub {
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .pill {
      display: inline-block;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 600;
      padding: 1px 6px;
      border-radius: 3px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--ink);
      white-space: nowrap;
    }

    .pill.CRITICAL, .pill.RED { color: var(--red); background: var(--red-bg); border-color: #fecaca; }
    .pill.HIGH, .pill.AMBER { color: var(--amber); background: var(--amber-bg); border-color: #fde68a; }
    .pill.WARN { color: var(--amber); background: var(--amber-bg); border-color: #fde68a; }
    .pill.GREEN { color: var(--green); background: var(--green-bg); border-color: #bbf7d0; }
    .pill.INFO { color: var(--blue); background: var(--blue-bg); border-color: #bfdbfe; }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 10px 0 18px;
      border: 1px solid var(--border);
      border-radius: 4px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      min-width: 560px;
    }

    th, td {
      padding: 8px 10px;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--border);
    }

    tbody tr:last-child td { border-bottom: none; }

    th {
      background: var(--surface);
      font-size: 11.5px;
      font-weight: 650;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--muted);
      white-space: nowrap;
    }

    pre {
      margin: 8px 0 14px;
      padding: 12px;
      background: #0f172a;
      color: #e2e8f0;
      border-radius: 4px;
      overflow-x: auto;
      line-height: 1.45;
    }

    td pre {
      margin: 0;
      padding: 8px;
      font-size: 11.5px;
      background: var(--surface);
      color: var(--ink);
      border: 1px solid var(--border);
      max-width: 380px;
    }

    .note {
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-left: 3px solid var(--brand-color);
      border-radius: 4px;
      background: var(--surface);
      font-size: 13px;
      color: var(--ink);
      margin: 10px 0 14px;
    }

    .note.warn {
      border-left-color: var(--red);
      background: var(--red-bg);
    }

    .load-order {
      margin: 6px 0 14px;
      padding-left: 20px;
      font-family: var(--mono);
      font-size: 13px;
    }

    .load-order li { margin-bottom: 3px; }

    details {
      border: 1px solid var(--border);
      border-radius: 4px;
      margin-bottom: 10px;
      background: var(--bg);
    }

    details > summary {
      padding: 10px 12px;
      cursor: pointer;
      background: var(--surface);
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 600;
      list-style-position: inside;
    }

    details[open] > summary {
      border-bottom: 1px solid var(--border);
    }

    .details-body { padding: 12px; }

    .flaw-item {
      padding-bottom: 8px;
      margin-bottom: 8px;
      border-bottom: 1px dashed var(--border);
    }

    .flaw-item:last-child {
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: none;
    }

    .flaw-meta {
      font-size: 12px;
      color: var(--muted);
      margin-top: 3px;
    }

    .flaw-sql {
      font-size: 12px;
      margin-top: 3px;
      word-break: break-word;
    }

    .num-bad { font-family: var(--mono); font-weight: 700; color: var(--red); }
    .num-ok { font-family: var(--mono); color: var(--green); }

    footer {
      margin-top: 40px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      font-size: 12px;
      color: var(--muted);
    }

    @media (max-width: 640px) {
      .wrap { padding: 16px 14px 36px; }
      h1 { font-size: 18px; }
      .summary-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .metric { padding: 10px; }
      .metric-val { font-size: 18px; }
      th, td { padding: 7px 8px; font-size: 12.5px; }
      details > summary { font-size: 12px; }
    }

    @media print {
      body { font-size: 11.5px; border-top: none; }
      .wrap { max-width: 100%; padding: 0; }
      .table-wrap { overflow: visible; border: none; }
      table { min-width: 0; }
      pre { background: #f8fafc; color: #0f172a; border: 1px solid #cbd5e1; white-space: pre-wrap; }
      details { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    {% set grade_color = executive_summary.readiness_grade.split()[0] %}
    <header>
      <div class="header-top">
        {% if branding.brand_logo %}
        <img src="{{ branding.brand_logo }}" alt="{{ branding.brand_name }} logo" class="brand-logo">
        {% endif %}
        <h1>{{ branding.brand_name }} &mdash; Schema Audit</h1>
        <span class="pill {{ grade_color }}">{{ executive_summary.readiness_grade }}</span>
      </div>
      <div class="meta-line">
        <span>target: <code>{{ metadata.source_redacted_url }}</code></span>
        <span>dialect: <code>{{ metadata.dialect }}</code></span>
        <span>version: <code>{{ metadata.crucible_version }}</code></span>
        <span>generated: <code>{{ metadata.generated_at }}</code></span>
      </div>
    </header>

    <div class="summary-bar">
      <div class="metric score-{{ grade_color }}">
        <div class="metric-label">Readiness</div>
        <div class="metric-val">{{ executive_summary.overall_readiness_score }}/100</div>
        <div class="metric-sub">{{ executive_summary.total_tables }} tables, {{ executive_summary.total_columns }} cols</div>
      </div>
      <div class="metric">
        <div class="metric-label">Est. Remediation</div>
        <div class="metric-val">{{ executive_summary.estimated_remediation_hours }}h</div>
        <div class="metric-sub">rule-weighted effort</div>
      </div>
      <div class="metric">
        <div class="metric-label">DMS Blockers</div>
        <div class="metric-val">{{ executive_summary.blocker_counts.dms_replication_blockers }}</div>
        <div class="metric-sub">CDC / encoding</div>
      </div>
      <div class="metric">
        <div class="metric-label">Referential</div>
        <div class="metric-val">{{ executive_summary.blocker_counts.referential_integrity_failures }}</div>
        <div class="metric-sub">orphan FK edges</div>
      </div>
      <div class="metric">
        <div class="metric-label">Data Hygiene</div>
        <div class="metric-val">{{ executive_summary.blocker_counts.semantic_data_rot }}</div>
        <div class="metric-sub">type / format flaws</div>
      </div>
      <div class="metric">
        <div class="metric-label">Shadow PII</div>
        <div class="metric-val">{{ executive_summary.blocker_counts.shadow_pii_exposures }}</div>
        <div class="metric-sub">unstructured text</div>
      </div>
    </div>

    <div class="note">
      Read-only scan. No raw cell values, orphan key values, or partial PII masks are written to this file. Run the generated <code>diagnostics/*_audit.sql</code> queries inside the source perimeter to inspect offending rows.
    </div>

    <!-- 1. DMS & CDC Blockers -->
    <h2>1. DMS &amp; CDC blockers</h2>
    {% set all_dms_blockers = [] %}
    {% for tname, tmeta in tables.items() %}
      {% for b in tmeta.dms_blockers %}
        {% set _ = all_dms_blockers.append({'table': tname, 'blocker': b}) %}
      {% endfor %}
    {% endfor %}

    {% if all_dms_blockers %}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Table</th>
            <th>Severity</th>
            <th>Rule</th>
            <th>Column</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          {% for item in all_dms_blockers %}
          <tr>
            <td><code>{{ item.table }}</code></td>
            <td><span class="pill {{ item.blocker.severity }}">{{ item.blocker.severity }}</span></td>
            <td><code>{{ item.blocker.blocker_id }}</code></td>
            <td>{% if item.blocker.column %}<code>{{ item.blocker.column }}</code>{% else %}&mdash;{% endif %}</td>
            <td>
              {{ item.blocker.description }}
              {% if item.blocker.blocker_id == "missing_primary_key_for_cdc" %}
                <div class="flaw-meta">AWS DMS cannot apply UPDATE/DELETE CDC events without a primary key.</div>
              {% elif item.blocker.blocker_id == "postgres_null_byte_poison" %}
                <div class="flaw-meta">PostgreSQL UTF-8 COPY and DMS tasks abort on 0x00 bytes.</div>
              {% elif item.blocker.blocker_id == "cp1252_encoding_ghosts" %}
                <div class="flaw-meta">CP1252 mojibake sequences fail strict UTF-8 target validation.</div>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p>No DMS replication blockers found.</p>
    {% endif %}

    <!-- 2. Shadow PII -->
    {% set pii_findings = [] %}
    {% for tname, tmeta in tables.items() %}
      {% for cname, cmeta in tmeta.columns.items() %}
        {% for f in cmeta.flaws %}
          {% if f.category == "shadow_pii_exposures" %}
            {% set _ = pii_findings.append({'table': tname, 'column': cname, 'flaw': f}) %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endfor %}

    <h2>2. Shadow PII</h2>
    {% if pii_findings %}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Table</th>
            <th>Column</th>
            <th>Rule</th>
            <th>Severity</th>
            <th>Counts &amp; Remediation</th>
          </tr>
        </thead>
        <tbody>
          {% for p in pii_findings %}
          <tr>
            <td><code>{{ p.table }}</code></td>
            <td><code>{{ p.column }}</code></td>
            <td><code>{{ p.flaw.flaw_id }}</code></td>
            <td><span class="pill {{ p.flaw.severity }}">{{ p.flaw.severity }}</span></td>
            <td>
              <div>{{ p.flaw.evidence }}</div>
              <div class="flaw-meta">{{ p.flaw.remediation_advice }}</div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p>No UK NINO, NHS number, or redaction marker patterns matched in sampled text columns.</p>
    {% endif %}

    <!-- 3. Topology & Foreign Keys -->
    <h2>3. Topology &amp; foreign keys</h2>
    <h3>Load order</h3>
    <ol class="load-order">
      {% for tbl in topology.load_order %}
      <li>{{ tbl }}</li>
      {% endfor %}
    </ol>

    {% if topology.fk_cycle_warning %}
    <div class="note warn">
      <strong>FK cycle detected:</strong> <code>{{ topology.fk_cycle_warning }}</code>. Load with deferred constraints.
    </div>
    {% endif %}

    <h3>Dependency graph (Mermaid)</h3>
    <pre>{{ topology.mermaid_dag }}</pre>

    <h3>Foreign key edges</h3>
    {% if topology.edges %}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Child</th>
            <th>Parent</th>
            <th>Type</th>
            <th>Status</th>
            <th>Orphan Rows</th>
            <th>Distinct Keys</th>
            <th>Diagnostic SQL</th>
          </tr>
        </thead>
        <tbody>
          {% for edge in topology.edges %}
          <tr>
            <td><code>{{ edge.child_table }}.{{ edge.child_col }}</code></td>
            <td><code>{{ edge.parent_table }}.{{ edge.parent_col }}</code></td>
            <td>
              {% if edge.relationship_type == "INFERRED_SHADOW_FK" %}
              <span class="pill WARN">INFERRED ({{ (edge.confidence * 100)|int }}%)</span>
              {% else %}
              <span class="pill INFO">DECLARED</span>
              {% endif %}
            </td>
            <td>
              {% if edge.status == "HEALTHY" %}
              <span class="pill GREEN">OK</span>
              {% else %}
              <span class="pill RED">ORPHANS</span>
              {% endif %}
            </td>
            <td>
              {% if edge.orphan_row_count > 0 %}
              <span class="num-bad">{{ edge.orphan_row_count }}</span>
              {% else %}
              <span class="num-ok">0</span>
              {% endif %}
            </td>
            <td>
              {% if edge.distinct_orphan_keys is defined and edge.distinct_orphan_keys > 0 %}
              <span class="num-bad">{{ edge.distinct_orphan_keys }}</span>
              {% else %}
              <span class="num-ok">0</span>
              {% endif %}
            </td>
            <td>
              {% if edge.diagnostic_sql %}
              <pre>{{ edge.diagnostic_sql }}</pre>
              {% else %}
              &mdash;
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p>No declared or inferred foreign key edges found.</p>
    {% endif %}

    <!-- 4. Table Profiles & dbt Models -->
    <h2>4. Table profiles &amp; dbt models</h2>
    {% for tname, tmeta in tables.items() %}
    <details>
      <summary>{{ tname }} &mdash; {{ tmeta.table_readiness_score }}/100 ({{ tmeta.row_count_estimate }} rows, {{ tmeta.columns|length }} cols)</summary>
      <div class="details-body">
        <p>
          pk: <code>{{ tmeta.declared_pk or "none" }}</code> &middot;
          sampled: <code>{{ tmeta.row_sample_size }}</code> &middot;
          score: <code>{{ tmeta.table_readiness_score }}/100</code>
        </p>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Column</th>
                <th>Declared</th>
                <th>Target</th>
                <th>Null / Distinct</th>
                <th>Findings</th>
              </tr>
            </thead>
            <tbody>
              {% for cname, cmeta in tmeta.columns.items() %}
              <tr>
                <td><code>{{ cname }}</code>{% if cmeta.is_declared_pk %} <span class="pill INFO">PK</span>{% endif %}</td>
                <td><code>{{ cmeta.declared_type }}</code></td>
                <td><code>{{ cmeta.recommended_target_type }}</code></td>
                <td><code>{{ (cmeta.null_rate * 100)|int }}%</code> / <code>{{ (cmeta.distinct_rate * 100)|int }}%</code></td>
                <td>
                  {% if cmeta.flaws %}
                    {% for f in cmeta.flaws %}
                      <div class="flaw-item">
                        <span class="pill {{ f.severity }}">{{ f.severity }}</span> <code>{{ f.flaw_id }}</code>
                        <div class="flaw-meta">{{ f.evidence }}</div>
                        <div class="flaw-sql">dbt: <code>{{ f.dbt_sql_expr }}</code></div>
                        {% if f.diagnostic_sql %}
                        <div class="flaw-sql">Audit SQL: <code>{{ f.diagnostic_sql }}</code></div>
                        {% endif %}
                      </div>
                    {% endfor %}
                  {% else %}
                    <span class="num-ok">ok</span>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {% if dbt_models and dbt_models[tname] %}
        <h3><code>stg_{{ tname }}.sql</code></h3>
        <pre>{{ dbt_models[tname] }}</pre>
        {% endif %}
      </div>
    </details>
    {% endfor %}

    <footer>{{ branding.brand_footer }}</footer>
  </div>
</body>
</html>
